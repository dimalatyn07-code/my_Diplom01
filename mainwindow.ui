        <item>
         <widget class="QPushButton" name="pushButton_5">
          <property name="styleSheet">
           <string notr="true">/* ===== КНОПКИ МЕНЮ ===== */

QPushButton {
    background-color: transparent;

    border: 1px solid transparent;
    border-radius: 14px;

    color: #ffffff;

    font-size: 15px;
    font-weight: 600;

    text-align: left;

    padding-left: 18px;
    padding-right: 18px;

    min-height: 30px;
    max-height: 30px;
}

/* ===== НАВЕДЕНИЕ ===== */

QPushButton:hover {
    background-color: rgba(0, 200, 150, 0.08);

    border: 1px solid #00c896;

    color: #ffffff;
}

/* ===== НАЖАТИЕ ===== */

QPushButton:pressed {
    background-color: rgba(0, 200, 150, 0.18);

    border: 1px solid #00e0a8;
}

/* ===== АКТИВНАЯ КНОПКА ===== */

QPushButton:checked {
    background-color: rgba(0, 200, 150, 0.12);

    border: 1px solid #00c896;

    color: #ffffff;
}

/* ===== ИКОНКА ===== */

QPushButton::icon {
    padding-left: 6px;
}</string>
