  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #07110f;
}

QWidget {
    color: #ecfff8;
    font-family: &quot;Segoe UI&quot;;
    font-size: 14px;
    background-color: transparent;
}

QFrame#indicator {
    background-color: #00c896;
    border-radius: 2px;
}

QWidget#centralwidget,
QWidget#centralWidget {
    background-color: #07110f;
}

QStackedWidget {
    background-color: #07110f;
}

QGroupBox {
    background-color: #0d1815;
    border: 1px solid #18352d;
    border-radius: 22px;
    padding: 28px;
}

QGroupBox:hover {
    border: 1px solid #00d39f;
}

QGroupBox QWidget {
    background-color: transparent;
}

QLabel {
    color: #d5f5ec;
    font-size: 15px;
    font-weight: 500;
}

QLabel#labelTitle {
    color: #ffffff;
    font-size: 34px;
    font-weight: 700;
    letter-spacing: 1px;
    padding-bottom: 10px;
}

QLabel#label_NameApplication {
    font-size: 35px;
    font-weight: 700;
}

QGroupBox#groupBox_Arrived QLabel#label_TitleArrived {
	font: 600 20pt &quot;Ubuntu Sans&quot;;
	font-weight: 500;
}

QGroupBox#groupBox_Arrived QLabel#label_NumberArrived {
	font: 600 35pt &quot;Ubuntu Sans&quot;;
	font-weight: 650;
}

QGroupBox#groupBox_Late QLabel#label_TitleLate {
	font: 600 20pt &quot;Ubuntu Sans&quot;;
	font-weight: 500;
}

QGroupBox#groupBox_Late QLabel#label_NumberLate {
	font: 600 35pt &quot;Ubuntu Sans&quot;;
	font-weight: 650;
}

QGroupBox#groupBox_Missing QLabel#label_TitleMissing {
	font: 600 20pt &quot;Ubuntu Sans&quot;;
	font-weight: 500;
}

QGroupBox#groupBox_Missing QLabel#label_NumberMissing {
	font: 600 35pt &quot;Ubuntu Sans&quot;;
	font-weight: 650;
}

/* === СТАТИСТИКА: groupBox_Arrived (зелёный) === */
QGroupBox#groupBox_Arrived {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 #2d5a4a, stop:1 #1a3d32);
    border: 2px solid #4a7c6a;
    border-radius: 4px;
    padding: 15px 20px;
}

QGroupBox#groupBox_Arrived:hover {
    border: 2px solid #5a9c8a;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 #3d6a5a, stop:1 #2a4d42);
}

QGroupBox#groupBox_Arrived QLabel {
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
    padding-left: 15px;
    padding-top: 8px;
}

/* === СТАТИСТИКА: groupBox_Late (оранжевый) === */
QGroupBox#groupBox_Late {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 #8b6a3d, stop:1 #5a4a2d);
    border: 2px solid #a67c4a;
    border-radius: 4px;
    padding: 15px 20px;
}

QGroupBox#groupBox_Late:hover {
    border: 2px solid #c69c5a;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 #9b7a4d, stop:1 #6a5a3d);
}

QGroupBox#groupBox_Late QLabel {
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
    padding-left: 15px;
    padding-top: 8px;
}

/* === СТАТИСТИКА: groupBox_Missing (красный) === */
QGroupBox#groupBox_Missing {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 #6a3d3d, stop:1 #4a2d2d);
    border: 2px solid #7c4a4a;
    border-radius: 4px;
    padding: 15px 20px;
}

QGroupBox#groupBox_Missing:hover {
    border: 2px solid #9c5a5a;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 #7a4d4d, stop:1 #5a3d3d);
}

QGroupBox#groupBox_Missing QLabel {
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
    padding-left: 15px;
    padding-top: 8px;
}

QLineEdit {
    background-color: #101d1a;
    border: 1px solid #21453b;
    border-radius: 12px;
    padding: 11px 14px;
    color: #f2fffb;
    font-size: 15px;
}

QLineEdit:hover {
    background-color: #132420;
    border: 1px solid #00b98b;
}

QLineEdit:focus {
    background-color: #152925;
    border: 2px solid #00d39f;
}

QLineEdit::placeholder {
    color: #6e8f84;
}

QPushButton {
    background-color: #10201b;
    color: #ecfff8;
    border: 1px solid #00c896;
    border-radius: 12px;
    padding: 10px 28px;
    font-size: 15px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #00c896;
    color: #04110d;
    border: 1px solid #00e0a8;
}

QPushButton:pressed {
    background-color: #009f77;
    color: #ffffff;
    border: 1px solid #00c896;
}

QPushButton:disabled {
    background-color: #111816;
    color: #5d746d;
    border: 1px solid #23312d;
}</string>
