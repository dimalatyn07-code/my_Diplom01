  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #07110f;
}

QWidget {
    color: #ecfff8;
    font-family: &quot;Segoe UI&quot;;
    font-size: 14px;
    background-color: transparent;
}

QFrame#indicator {
    background-color: #00c896;
    border-radius: 2px;
}

QFrame#frame_BackgroundStatusSystems {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 #2d5a4a, stop:1 #1a3d32);
    border-radius: 6px;
    border: none;
}

QWidget#centralwidget,
QWidget#centralWidget {
    background-color: #07110f;
}

QStackedWidget {
    background-color: #07110f;
}

QGroupBox {
    background-color: #0d1815;
    border: 1px solid #18352d;
    border-radius: 22px;
    padding: 28px;
}

QGroupBox:hover {
    border: 1px solid #00d39f;
}

QGroupBox QWidget {
    background-color: transparent;
}

QLabel {
    color: #d5f5ec;
    font-size: 15px;
    font-weight: 500;
}

QLabel#label_StatusSystems {
    font-size: 25px;
    font-weight: 700;
}

QLabel#labelTitle {
    color: #ffffff;
    font-size: 34px;
    font-weight: 700;
    letter-spacing: 1px;
    padding-bottom: 10px;
}

QLabel#label_NameApplication,
QLabel#label_NameApplication_2,
QLabel#label_NameApplication_3{
    font-size: 35px;
    font-weight: 700;
}

QLabel#label_Log,
QLabel#label_ControlsCamera,
QLabel#label_CalibrationCamera{
    font-size: 20px;
    font-weight: 700;
}

QLabel#label_RegistrationGuest {
    font-size: 30px;
    font-weight: 700;
}

QLabel#label_NameGrupBoksStatusCamera {
    font-size: 30px;
    font-weight: 700;
}

QLabel#label_StatusCamera {
    font-size: 15px;
    font-weight: 700;
}


QGroupBox#groupBox_Arrived QLabel#label_TitleArrived {
	font: 600 20pt &quot;Ubuntu Sans&quot;;
	font-weight: 500;
}

QGroupBox#groupBox_Arrived QLabel#label_NumberArrived {
	font: 600 35pt &quot;Ubuntu Sans&quot;;
	font-weight: 650;
}

QGroupBox#groupBox_Late QLabel#label_TitleLate {
	font: 600 20pt &quot;Ubuntu Sans&quot;;
	font-weight: 500;
}

QGroupBox#groupBox_Late QLabel#label_NumberLate {
	font: 600 35pt &quot;Ubuntu Sans&quot;;
	font-weight: 650;
}

QGroupBox#groupBox_Missing QLabel#label_TitleMissing {
	font: 600 20pt &quot;Ubuntu Sans&quot;;
	font-weight: 500;
}

QGroupBox#groupBox_Missing QLabel#label_NumberMissing {
	font: 600 35pt &quot;Ubuntu Sans&quot;;
	font-weight: 650;
}

QGroupBox#groupBox_RegistrationGuest {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 #153028, stop:1 #0a1d18);
    border: 2px solid #4a7c6a;
    border-radius: 4px;
    padding: 15px 20px;
}

QGroupBox#groupBox_StatusCamera {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 #153028, stop:1 #0a1d18);
    border: 2px solid #4a7c6a;
    border-radius: 4px;
    padding: 15px 20px;
}

/* === СТАТИСТИКА: groupBox_Arrived (зелёный) === */
QGroupBox#groupBox_Arrived {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 #2d5a4a, stop:1 #1a3d32);
    border: 2px solid #4a7c6a;
    border-radius: 4px;
    padding: 15px 20px;
}

QGroupBox#groupBox_Arrived:hover {
    border: 2px solid #5a9c8a;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 #3d6a5a, stop:1 #2a4d42);
}

QGroupBox#groupBox_Arrived QLabel {
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
    padding-left: 15px;
    padding-top: 8px;
}

/* === СТАТИСТИКА: groupBox_Late (оранжевый) === */
QGroupBox#groupBox_Late {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 #8b6a3d, stop:1 #5a4a2d);
    border: 2px solid #a67c4a;
    border-radius: 4px;
    padding: 15px 20px;
}

QGroupBox#groupBox_Late:hover {
    border: 2px solid #c69c5a;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 #9b7a4d, stop:1 #6a5a3d);
}

QGroupBox#groupBox_Late QLabel {
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
    padding-left: 15px;
    padding-top: 8px;
}

/* === СТАТИСТИКА: groupBox_Missing (красный) === */
QGroupBox#groupBox_Missing {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 #6a3d3d, stop:1 #4a2d2d);
    border: 2px solid #7c4a4a;
    border-radius: 4px;
    padding: 15px 20px;
}

QGroupBox#groupBox_Missing:hover {
    border: 2px solid #9c5a5a;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 #7a4d4d, stop:1 #5a3d3d);
}

QGroupBox#groupBox_Missing QLabel {
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
    padding-left: 15px;
    padding-top: 8px;
}

/* === Биометрия групп боксы === */
QGroupBox#groupBox_ControlsCamera,
QGroupBox#groupBox_Calibration,
QGroupBox#groupBox_Log {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 rgba(18, 58, 50, 0.85), stop:1 rgba(10, 34, 25, 0.85));
    border: 1px solid #1a3d32;
    border-radius: 14px;
    padding: 20px;
    margin: 5px;
}

QGroupBox#groupBox_ControlsCamera::title,
QGroupBox#groupBox_Calibration::title,
QGroupBox#groupBox_Log::title {
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 10px;
}

QLineEdit {
    background-color: #101d1a;
    border: 1px solid #21453b;
    border-radius: 12px;
    padding: 11px 14px;
    color: #f2fffb;
    font-size: 15px;
}

QLineEdit:hover {
    background-color: #132420;
    border: 1px solid #00b98b;
}

QLineEdit:focus {
    background-color: #152925;
    border: 2px solid #00d39f;
}

QLineEdit::placeholder {
    color: #6e8f84;
}

QLineEdit#lineEdit_FullName,
QLineEdit#lineEdit_PhoneNumber,
QLineEdit#lineEdit_Organization,
QLineEdit#lineEdit_TargetVisit,
QLineEdit#lineEdit_Recipient{
    background-color: #1a3d32;
    border: 2px solid #00c896;
    border-radius: 8px;
    padding: 10px 15px;
    color: #ffffff;
    font-size: 16px;
}

QPushButton {
    background-color: #10201b;
    color: #ecfff8;
    border: 1px solid #00c896;
    border-radius: 12px;
    padding: 10px 28px;
    font-size: 15px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #00c896;
    color: #04110d;
    border: 1px solid #00e0a8;
}

QPushButton:pressed {
    background-color: #009f77;
    color: #ffffff;
    border: 1px solid #00c896;
}

QPushButton:disabled {
    background-color: #111816;
    color: #5d746d;
    border: 1px solid #23312d;
}

QPushButton#pushButton_RegistrationGuest {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 #00e0a8, stop:1 #00b98b);
    border: 2px solid #00c896;
    border-radius: 10px;
    padding: 12px 30px;
    color: #04110d;
    font-size: 16px;
    font-weight: 700;
}

QPushButton#pushButton_RegistrationGuest:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 #00f0b8, stop:1 #00c99b);
    border: 2px solid #00e0a8;
}

QPushButton#pushButton_RegistrationGuest:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 #00b98b, stop:1 #009f77);
    border: 2px solid #00a87a;
}

QTimeEdit#timeEdit_TimeComing {
    background-color: #1a3d32;
    border: 2px solid #00c896;
    border-radius: 8px;
    padding: 10px 15px;
    color: #ffffff;
    font-size: 16px;
}

QTimeEdit#timeEdit_TimeComing focus,{
    border: 2px solid #00e0a8;
    background-color: #1f4a3d;
}

/* === СТИЛЬ ТУМБЛЕРА === */
/* === СТИЛЬ ТУМБЛЕРА (ИСПРАВЛЕННЫЙ) === */
QCheckBox#toggleSwitch {
    spacing: 0;
    width: 60px;
    height: 32px;
    margin: 0;
    padding: 0;
}

QCheckBox#toggleSwitch::indicator {
    width: 60px;
    height: 32px;
    border-radius: 16px;
    border: none;
    margin: 0;
    padding: 0;
}

/* Когда включён (зелёный) */
QCheckBox#toggleSwitch::indicator:checked {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, 
        fx:0.5, fy:0.5, 
        stop:0 #a8ffb0, 
        stop:0.6 #7fff7f, 
        stop:1 #4ac94a);
    border: 2px solid #5fd95f;
}

/* Когда выключен (серый) */
QCheckBox#toggleSwitch::indicator:unchecked {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, 
        fx:0.5, fy:0.5, 
        stop:0 #5a6a65, 
        stop:1 #3a4a45);
    border: 2px solid #4a5a55;
}

/* Правильно: пробел между селекторами = вложенность */
QProgressBar#progressBar_Calebrovka {
    background-color: #1a3d32;
    border: none;
    border-radius: 8px;
    height: 20px;
    text-align: center;
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
}

QProgressBar#progressBar_Calebrovka::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 #7fff7f, 
        stop:0.5 #5fd95f, 
        stop:1 #4ac94a);
    border-radius: 8px;
    margin: 0;
}</string>
