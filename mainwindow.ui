  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #07110f;
}

QWidget {
    color: #ecfff8;
    font-family: &quot;Segoe UI&quot;;
    font-size: 14px;
    background-color: transparent;
}
QFrame#indicator {
    background-color: #00c896;

    border-radius: 2px;
}

QWidget#centralwidget,
QWidget#centralWidget {
    background-color: #07110f;
}

QStackedWidget {
    background-color: #07110f;
}

QGroupBox {
    background-color: #0d1815;

    border: 1px solid #18352d;
    border-radius: 22px;

    padding: 28px;
}

QGroupBox:hover {
    border: 1px solid #00d39f;
}

QGroupBox QWidget {
    background-color: transparent;
}

QLabel {
    color: #d5f5ec;

    font-size: 15px;
    font-weight: 500;
}

QLabel#labelTitle {
    color: #ffffff;

    font-size: 34px;
    font-weight: 700;

    letter-spacing: 1px;

    padding-bottom: 10px;
}

QLineEdit {
    background-color: #101d1a;

    border: 1px solid #21453b;
    border-radius: 12px;

    padding: 11px 14px;

    color: #f2fffb;

    font-size: 15px;
}

QLineEdit:hover {
    background-color: #132420;
    border: 1px solid #00b98b;
}

QLineEdit:focus {
    background-color: #152925;
    border: 2px solid #00d39f;
}

QLineEdit::placeholder {
    color: #6e8f84;
}

QPushButton {
    background-color: #10201b;

    color: #ecfff8;

    border: 1px solid #00c896;
    border-radius: 12px;

    padding: 10px 28px;

    font-size: 15px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #00c896;

    color: #04110d;

    border: 1px solid #00e0a8;
}

QPushButton:pressed {
    background-color: #009f77;

    color: #ffffff;

    border: 1px solid #00c896;
}

QPushButton:disabled {
    background-color: #111816;

    color: #5d746d;

    border: 1px solid #23312d;
}</string>
